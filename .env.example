# Price Scraper Configuration

# The URL of the product page you want to monitor (Default is a demo books site)
PRODUCT_URL="http://books.toscrape.com/catalogue/a-light-in-the-attic_1000/index.html"

# The CSS Selector to locate the price text inside the HTML
# (e.g. for books.toscrape.com, the price is in a <p class="price_color"> tag)
PRICE_SELECTOR="p.price_color"

# Email Configuration (SMTP)
# If using Gmail, use smtp.gmail.com with port 587.
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SENDER_EMAIL="your-email@gmail.com"
SENDER_PASSWORD="your-app-password" # For Gmail, use a 16-character App Password
RECEIVER_EMAIL="recipient-email@gmail.com"
